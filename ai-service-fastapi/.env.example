LLM_PROVIDER=groq

GROQ_API_KEY=gsk_your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b

# Leave blank unless you switch LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-5

# Leave blank unless you switch LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

INTERNAL_API_KEY=replace-with-a-long-random-shared-secret

DATABASE_URL=postgresql://your_pg_username:your_pg_password@localhost:port/database_name
